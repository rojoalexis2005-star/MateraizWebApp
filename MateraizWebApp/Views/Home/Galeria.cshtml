@model IEnumerable<MateraizWebApp.Models.Producto>

@{
    ViewData["Title"] = "Galería";
}

<style>
    /* Efecto para ocultar/mostrar detalles al tocar la imagen */
    .producto-card {
        cursor: pointer;
        transition: transform 0.3s ease;
    }

        .producto-card:hover {
            transform: translateY(-5px);
        }

    .detalles-producto {
        display: none; /* Oculto por defecto */
        animation: fadeIn 0.5s;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>

<div class="container my-5">
    <h2 class="text-center mb-5 fw-bold" style="color:#556B2F;">🌿 Galería de Productos</h2>

    <div class="row">
        @foreach (var item in Model)
        {
            var mensaje = $"Hola, me interesa el producto: {item.Nombre} - Precio: ${item.Precio}";
            var mensajeCodificado = Uri.EscapeDataString(mensaje);
            var cardId = "details-" + item.Id;

            <div class="col-md-4 mb-4">
                <div class="card shadow h-100 border-0 producto-card" onclick="toggleDetails('@cardId')">

                    <div class="position-relative">
                        <img src="@item.ImagenUrl"
                             class="card-img-top"
                             style="height:350px; object-fit:cover; border-radius: 15px 15px 0 0;" />
                        <div class="position-absolute bottom-0 start-0 m-2 badge bg-dark opacity-75">
                            Click para ver detalles
                        </div>
                    </div>

                    <div class="card-body text-center">
                        <h5 class="fw-bold mb-3">@item.Nombre</h5>

                        <div id="@cardId" class="detalles-producto">
                            <p class="text-muted small">@item.Descripcion</p>

                            <p class="fw-bold text-success fs-5 mb-1">$@item.Precio</p>

                            <p class="mb-3 text-secondary">
                                <strong>Tamaño:</strong> @item.Tamaño
                            </p>

                            <div class="card-footer bg-white border-0 pb-3">
                                <button onclick="confirmarWhatsapp(event, '@mensajeCodificado')"
                                        class="btn btn-success rounded-pill px-4 shadow-sm fw-bold">
                                    📱 Ordenar ahora
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Función para mostrar/ocultar detalles
        function toggleDetails(id) {
            var x = document.getElementById(id);
            if (x.style.display === "none" || x.style.display === "") {
                x.style.display = "block";
            } else {
                x.style.display = "none";
            }
        }

        // Función de confirmación para WhatsApp
        function confirmarWhatsapp(event, mensaje) {
            event.stopPropagation(); // Evita que al hacer clic en el botón se cierre el detalle

            Swal.fire({
                title: '¿Ir a WhatsApp?',
                text: "Estás a punto de contactar a Materaíz para ordenar este producto.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#556B2F',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Sí, ir ahora',
                cancelButtonText: 'No, cancelar',
                borderRadis: '20px'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.open('https://wa.me/525520596077?text=' + mensaje, '_blank');
                }
            })
        }
    </script>
}