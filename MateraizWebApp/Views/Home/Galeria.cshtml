@model IEnumerable<MateraizWebApp.Models.Producto>

@{
    ViewData["Title"] = "Galería";
}

<div class="container my-5">
    <h2 class="text-center mb-5 fw-bold">🌿 Galería de Productos</h2>

    <div class="row">
        @foreach (var item in Model)
        {
            var mensaje = $"Hola, me interesa el producto: {item.Nombre} - Precio: ${item.Precio}";
            var mensajeCodificado = Uri.EscapeDataString(mensaje);

            <div class="col-md-4 mb-4">
                <div class="card shadow h-100 border-0">

                    <img src="@item.ImagenUrl"
                         class="card-img-top"
                         style="height:300px; object-fit:cover;" />

                    <div class="card-body text-center">
                        <h5 class="fw-bold">@item.Nombre</h5>

                        <p class="text-muted small">
                            @item.Descripcion
                        </p>

                        <p class="fw-bold text-success fs-5">
                            $@item.Precio
                        </p>

                        <p>
                            <strong>Tamaño:</strong> @item.Tamaño
                        </p>
                    </div>

                    <div class="card-footer bg-white border-0 text-center pb-4">

                        <a href="https://wa.me/525520596077?text=@mensajeCodificado"
                           target="_blank"
                           class="btn btn-success rounded-pill px-4 shadow-sm">
                            📱 Ordenar ahora
                        </a>

                    </div>

                </div>
            </div>
        }
    </div>
</div>