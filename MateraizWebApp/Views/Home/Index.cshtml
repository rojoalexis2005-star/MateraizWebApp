@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-section text-center text-white d-flex align-items-center">
    <div class="container">
        <img src="~/images/logo.png" width="120" class="mb-4 shadow-lg rounded-circle" />

        <h1 class="display-3 fw-bold">Materaíz</h1>
        <p class="lead fs-4">“Donde la naturaleza se convierte en arte.”</p>
        <p class="mb-4">Producto artesanal, ecológico y con valor social.</p>

        <a asp-controller="Home"
           asp-action="Galeria"
           class="btn btn-lg btn-materaiz me-3 px-4">
            Ver Productos
        </a>

        
    </div>
</section>

<section class="container text-center my-5">
    <h2 class="mb-4">🌿 ¿Por qué elegir Materaíz?</h2>

    <div class="row">
        <div class="col-md-4">
            <h4>🌱 100% Natural</h4>
            <p>Elaborado con fruto de coatecomate biodegradable.</p>
        </div>

        <div class="col-md-4">
            <h4>👵 Impacto Social</h4>
            <p>Generamos empleo para adultos mayores.</p>
        </div>

        <div class="col-md-4">
            <h4>🎨 Artesanal</h4>
            <p>Cada pieza es única y hecha a mano.</p>
        </div>
    </div>
</section>
