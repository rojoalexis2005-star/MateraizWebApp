@{
    ViewData["Title"] = "Sobre el Producto";
}

<section class="page-header text-white text-center d-flex align-items-center">
    <div class="container">
        <h1 class="fw-bold">Sobre Materaíz</h1>
        <p class="lead">Tradición, naturaleza y arte en cada maceta</p>
    </div>
</section>

<section class="container my-5">

    <div class="row align-items-center">
        <div class="col-md-6">
            <img src="~/images/imagen3.jpeg" class="img-fluid rounded shadow" />
        </div>

        <div class="col-md-6">
            <h3 class="mb-3">¿Qué es Materaíz?</h3>
            <p>
                Materaíz es una maceta artesanal elaborada a partir del fruto natural del coatecomate,
                originario de Guerrero. Cada pieza es trabajada manualmente,
                preservando técnicas tradicionales.
            </p>
        </div>
    </div>

    <hr class="my-5" />

    <h3 class="text-center mb-4">Proceso Artesanal</h3>

    <div class="row text-center">
        <div class="col-md-3">
            <div class="card shadow p-3">
                🌿
                <h5>Recolección</h5>
                <p>Selección del fruto natural.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow p-3">
                ☀️
                <h5>Secado</h5>
                <p>Proceso natural de deshidratación.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow p-3">
                🧼
                <h5>Limpieza</h5>
                <p>Tratamiento y preparación.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow p-3">
                🎨
                <h5>Decoración</h5>
                <p>Acabado artesanal único.</p>
            </div>
        </div>
    </div>

</section>
