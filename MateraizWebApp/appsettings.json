{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};SSL Mode=Require;Trust Server Certificate=true"
  },
  "EmailSettings": {
    "Email": "${EMAIL_USER}",
    "Password": "${EMAIL_PASSWORD}",
    "Host": "smtp.gmail.com",
    "Port": 587
  }
}