@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center" style="min-height:80vh;">
    <div class="card shadow p-5" style="width:420px; border-radius:20px;">

        <h3 class="text-center" style="color:#556B2F;">🔐 Nueva contraseña</h3>

        <p class="text-center mt-2">
            Ingresa tu nueva contraseña para continuar.
        </p>

        <form method="post" class="mt-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="Input.Code" type="hidden" />

            <div class="form-floating mb-3">
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username" />
                <label asp-for="Input.Email">Correo electrónico</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <!-- PASSWORD -->
            <div class="form-floating mb-3 position-relative">
                <input asp-for="Input.Password"
                       type="password"
                       class="form-control"
                       id="passwordField"
                       autocomplete="new-password" />

                <label asp-for="Input.Password">Nueva contraseña</label>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary position-absolute end-0 top-50 translate-middle-y me-2"
                        onclick="togglePassword('passwordField')">
                    👁
                </button>

                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <!-- CONFIRM PASSWORD -->
            <div class="form-floating mb-4 position-relative">
                <input asp-for="Input.ConfirmPassword"
                       type="password"
                       class="form-control"
                       id="confirmPasswordField"
                       autocomplete="new-password" />

                <label asp-for="Input.ConfirmPassword">Confirmar contraseña</label>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary position-absolute end-0 top-50 translate-middle-y me-2"
                        onclick="togglePassword('confirmPasswordField')">
                    👁
                </button>

                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn w-100 text-white"
                    style="background-color:#556B2F;">
                Restablecer contraseña
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(fieldId) {
            var field = document.getElementById(fieldId);
            field.type = field.type === "password" ? "text" : "password";
        }
    </script>
}