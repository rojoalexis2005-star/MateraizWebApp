@page
@model LogoutModel
@{
    ViewData["Title"] = "Sesión cerrada";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center" style="min-height:80vh;">
    <div class="card shadow p-4 text-center" style="width:400px; border-radius:20px;">

        <h3 style="color:#556B2F;">🌿 Sesión cerrada</h3>

        <p class="mt-3">
            Gracias por visitar <strong>Materaíz</strong>.
        </p>

        <a asp-controller="Home" asp-action="Index"
           class="btn text-white mt-3"
           style="background-color:#556B2F;">
            Volver al inicio
        </a>

    </div>
</div>