@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Correo enviado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center" style="min-height:80vh;">
    <div class="card shadow p-5 text-center" style="width:420px; border-radius:20px;">

        <h3 style="color:#556B2F;">📩 Correo enviado</h3>

        <p class="mt-3">
            Si el correo ingresado está registrado en nuestro sistema,
            recibirás un enlace para restablecer tu contraseña.
        </p>

        <p class="text-muted mt-2" style="font-size: 0.9rem;">
            Revisa también tu carpeta de spam.
        </p>

        <a asp-page="./Login"
           class="btn text-white mt-4"
           style="background-color:#556B2F;">
            Volver a iniciar sesión
        </a>

    </div>
</div>