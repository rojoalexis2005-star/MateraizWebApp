@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña actualizada";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center" style="min-height:80vh;">
    <div class="card shadow p-5 text-center" style="width:420px; border-radius:20px;">

        <h3 style="color:#556B2F;">🔐 Contraseña actualizada</h3>

        <p class="mt-3">
            Tu contraseña fue restablecida correctamente.
        </p>

        <a asp-page="./Login"
           class="btn text-white mt-3"
           style="background-color:#556B2F;">
            Iniciar sesión
        </a>

    </div>
</div>