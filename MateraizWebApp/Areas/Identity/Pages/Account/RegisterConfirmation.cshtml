@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmación de Registro";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow p-4 text-center" style="border-radius:20px;">

                <h2 style="color:#556B2F;">🌿 ¡Registro exitoso!</h2>

                <hr />

                @if (Model.DisplayConfirmAccountLink)
                {
                    <p class="mb-3">
                        Esta aplicación no tiene configurado un servicio real de correo.
                    </p>

                    <a id="confirm-link"
                       href="@Model.EmailConfirmationUrl"
                       class="btn btn-success">
                        Confirmar cuenta
                    </a>
                }
                else
                {
                    <p class="text-muted">
                        📩 Hemos enviado un correo para confirmar tu cuenta.
                    </p>

                    <p>
                        Por favor revisa tu bandeja de entrada.
                    </p>
                }

                <div class="mt-4">
                    <a asp-area="" asp-controller="Home" asp-action="Index"
                       class="btn btn-outline-secondary">
                        Volver al inicio
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>