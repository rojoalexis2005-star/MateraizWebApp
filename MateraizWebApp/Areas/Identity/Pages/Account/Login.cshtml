@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center" style="min-height:80vh;">
    <div class="card shadow-lg p-4" style="width:400px; border-radius:20px;">

        <div class="text-center mb-4">
            <img src="~/images/logo.png" width="80" class="rounded-circle mb-2" />
            <h3 style="color:#556B2F;"><strong>Materaíz</strong></h3>
            <p class="text-muted">Bienvenido de nuevo 🌿</p>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" />
            </div>

            <div class="mb-3 position-relative">
                <label asp-for="Input.Password" class="form-label"></label>

                <input asp-for="Input.Password"
                       class="form-control"
                       id="loginPassword" />

                <span onclick="toggleLoginPassword()"
                      style="position:absolute; right:15px; top:38px; cursor:pointer;">
                    👁
                </span>
                @section Scripts {
                    <script>
                        function toggleLoginPassword() {
                            var input = document.getElementById("loginPassword");
                            input.type = input.type === "password" ? "text" : "password";
                        }
                    </script>
                }
            </div>

            <div class="form-check mb-3">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn w-100 text-white"
                    style="background-color:#556B2F;">
                Iniciar Sesión
            </button>

            <div class="text-center mt-3">
                <a asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a>
            </div>

            <hr />

            <div class="text-center">
                <span>¿No tienes cuenta?</span><br />
                <a asp-page="./Register" class="btn btn-outline-success mt-2">
                    Crear Cuenta
                </a>
            </div>
        </form>
    </div>
</div>
